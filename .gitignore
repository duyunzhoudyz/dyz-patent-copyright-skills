# GitHub source scope: new root entries require an explicit opt-in.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/README_EN.md
!/CHANGELOG.md
!/LICENSE
!/COMMERCIAL-LICENSE.md
!/CONTRIBUTING.md
!/CONTRIBUTOR-LICENSE.md
!/RELEASE.md
!/SECURITY.md
!/THIRD-PARTY-NOTICES.md
!/release.json
!/docs/
!/evals/
!/references/
!/skills/
!/tools/

# Publish stable specifications and research attribution, not work logs or plans.
/docs/*
!/docs/capability-blueprint.md
!/docs/capability-contracts.md
!/docs/development-standards.md
!/docs/disclosure-and-handoff.md
!/docs/reference-analysis.md
!/docs/roadmap-and-quality.md
!/docs/github-skill-comparison-20261102.md
!/docs/github-skill-comparison-20261102-sources.json

# Local research, agent notes, case materials and generated results.
/.references/
/竞品对比/
/AGENTS.md
/private/
/outputs/
/tmp/
/evals/workflows/

# Local editor state, environments, credentials and test/build artifacts.
.breezell/
.vscode/
.idea/
.venv/
venv/
.env
.env.*
!.env.example
*.pem
*.key
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
*.log
build/
dist/
*.egg-info/
.DS_Store
Thumbs.db
