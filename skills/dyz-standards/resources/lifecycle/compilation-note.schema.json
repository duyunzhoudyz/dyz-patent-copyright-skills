{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dyz/standards/compilation-note/v1",
  "title": "编制说明结构（11 节）",
  "description": "标准送审阶段编制说明的结构契约。只约束结构与状态字段，不校验技术内容正确性；state=explicit 的 source 不得为空。AF-03 实施时由 tools.standards._candidate 消费。",
  "type": "object",
  "required": ["standard_name", "version", "clause_digest", "sections"],
  "additionalProperties": false,
  "properties": {
    "standard_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "clause_digest": {
      "type": "string",
      "minLength": 1,
      "description": "本说明所解释正文的 clauses digest；与当前正文不符即视为旧版说明。"
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/section" },
      "description": "按 id 升序排列的 11 节；缺任一 id 即为未完成。"
    }
  },
  "$defs": {
    "sectionId": {
      "type": "string",
      "enum": [
        "note-01-work-overview",
        "note-02-background-purpose",
        "note-03-principles-basis",
        "note-04-technical-content-basis",
        "note-05-comparison",
        "note-06-legal-standard-relation",
        "note-07-major-divergence",
        "note-08-nature-and-implementation",
        "note-09-comment-disposition",
        "note-10-verification",
        "note-11-open-items"
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "heading", "body", "state", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/sectionId" },
        "heading": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "source": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "依据来源（文件 ID / 条款位置 / 记录编号）。state=explicit 时不得为空。"
        },
        "state": {
          "type": "string",
          "enum": ["explicit", "inferred", "unknown", "not_applicable"]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "本节内容的责任人/责任单位。unknown 状态必须有 owner。"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "state=unknown 时必填：具体待确认问题，不得写“进一步研究”。"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "state=not_applicable 时必填：不适用的具体理由。"
        },
        "open_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/openItem" },
          "description": "未决事项；第 11 节必填，其他节记录本节遗留缺口。"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "explicit" } }, "required": ["state"] },
          "then": { "required": ["source"], "properties": { "source": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "state": { "const": "unknown" } }, "required": ["state"] },
          "then": { "required": ["question"] }
        },
        {
          "if": { "properties": { "state": { "const": "not_applicable" } }, "required": ["state"] },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "openItem": {
      "type": "object",
      "required": ["question", "owner", "blocks", "recovery"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "string",
          "enum": ["submission", "approval", "publication", "none"],
          "description": "阻塞哪一步；none 表示已确认不影响推进。"
        },
        "recovery": { "type": "string", "minLength": 1, "description": "恢复推进的条件。" }
      }
    }
  }
}
